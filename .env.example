# =============================================================================
# OmniSales production secrets
#
# Copy this file to `.env` (next to `docker-compose.yml`) and fill in the
# real values. Never commit `.env` to git.
#
# Then start the stack with:
#   docker compose --env-file .env up -d --build
# =============================================================================

# ---------- Database ----------
DB_USERNAME=postgres
DB_PASSWORD=changeme_strong_db_password
DB_NAME=OSMS
# Only used when exposing postgres to the host (e.g. for psql access).
DB_EXTERNAL_PORT=5432

# ---------- Backend ports ----------
BACKEND_EXTERNAL_PORT=8080
FRONTEND_EXTERNAL_PORT=80

# ---------- JWT ----------
JWT_SECRET=changeme_random_long_secret_min_32_chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------- Frontend / CORS ----------
FRONTEND_URL=https://your-domain.com
# Injected at frontend build time. Defaults to `/api` (proxied by nginx).
VITE_API_BASE_URL=/api
VITE_FRONTEND_URL=https://your-domain.com

# ---------- Email (Gmail SMTP) ----------
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
NOTIFICATION_EMAIL_ENABLED=false

# ---------- Country API ----------
REST_COUNTRIES_API_KEY=

# ---------- Shopify ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/channels/shopify/callback
SHOPIFY_SCOPES=write_products,read_products,write_inventory,read_inventory,read_orders,write_orders
# Required for Shopify → your-app push events. Must be reachable by Shopify.
SHOPIFY_WEBHOOK_CALLBACK_URL=https://your-domain.com/api/channels/shopify/webhook

# ---------- Lazada ----------
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=https://your-domain.com/api/channels/lazada/callback
LAZADA_WEBHOOK_CALLBACK_URL=https://your-domain.com/api/channels/lazada/webhook

# ---------- TikTok ----------
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
TIKTOK_REFRESH_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/refresh
TIKTOK_API_URL=https://open-api.tiktokglobalshop.com

# ---------- HTTPS Reverse Proxy (Caddy) ----------
# Set DOMAIN to enable the `proxy` service:
#   docker compose --profile prod --env-file .env up -d
# Leave empty for local dev — the bundled frontend nginx already serves the app on :80.
DOMAIN=
EMAIL=

# ---------- Backup ----------
# Directory inside the backend container where pg_dump writes the .backup files.
# Compose mounts a named volume onto this path so backups persist across restarts.
APP_BACKUP_DIRECTORY=/app/backups