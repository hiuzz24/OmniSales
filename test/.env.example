# ============================================================
# OmniSales Test Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Windows PowerShell:
#   Copy-Item .env.example .env
# Linux/macOS:
#   cp .env.example .env
# ============================================================

# Login credentials used by the E2E and API tests.
TEST_EMAIL=manager@osms.vn
TEST_PASSWORD=Duy16042004%

# Admin credentials (SYSTEM_ADMIN role). Override if your seed data differs.
# Defaults match hibernate-schema.sql: admin@osms.vn / 11111111
ADMIN_EMAIL=admin@osms.vn
ADMIN_PASSWORD=11111111

# Backend and frontend base URLs (override only when running against a
# non-default environment).
API_BASE=http://localhost:8080/api
FRONTEND_URL=http://localhost:5174