# =============================================================================
# Frontend production environment (Vite SPA).
#
# Copy sang `.env.production` cho docker-compose / `.env` cho local dev.
# Trên Render, các biến này được inject lúc build thông qua render.yaml
# (service `app-osms` mục envVars).
#
# KHÔNG commit .env thật — chỉ file này vào git.
# =============================================================================

# Backend API base URL.
#   * Local docker-compose: /api (nginx proxy localhost:80/api → backend:8080)
#   * Render: https://api-osms.onrender.com/api (CORS sẽ phải config sẵn)
VITE_API_BASE_URL=/api

# Frontend public URL (hiển thị trên OAuth redirect, error pages, etc.)
VITE_FRONTEND_URL=http://localhost:5174

# API timeout (ms) — Render free tier có thể spin up chậm, để 30s cho chắc.
VITE_API_TIMEOUT=30000

# Mock mode. BẮT BUỘC false ở production (sẽ không gọi backend).
VITE_USE_MOCK=false

# Cloudinary — dùng cho upload ảnh (catalog/products).
# Cloud name public, upload preset phải là unsigned preset.
VITE_CLOUDINARY_CLOUD_NAME=dwf1n70ew
VITE_CLOUDINARY_UPLOAD_PRESET=OmniSales

# TikTok authorize URL (override cho từng tenant).
VITE_TIKTOK_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize?service_id=7660230624213960469
