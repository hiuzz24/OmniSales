# =========================
# DEFAULT NORMALIZATION
# =========================
* text=auto

# =========================
# MAVEN WRAPPER (Spring Boot)
# =========================
/mvnw text eol=lf
/mvnw.cmd text eol=crlf
*.sh text eol=lf

# =========================
# BACKEND (JAVA / SPRING BOOT)
# =========================
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# =========================
# FRONTEND (REACT / VITE)
# =========================
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# =========================
# WINDOWS SCRIPTS
# =========================
*.bat text eol=crlf
*.cmd text eol=crlf

# =========================
# IMAGES / BINARIES (NO CONVERT)
# =========================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary