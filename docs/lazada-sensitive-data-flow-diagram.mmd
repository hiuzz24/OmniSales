flowchart LR
    subgraph INTERNAL["Internal Environment"]
        direction TB
        USER["👤 Authorized Internal\nUser / Staff"]
        FE["🖥️ OSMS Frontend\n(React SPA)"]
    end

    BE["⚙️ OSMS Backend API\n(Spring Boot)"]
    DB[("🗄️ PostgreSQL\nDatabase")]

    subgraph LAZADA["Lazada External Services"]
        direction TB
        API["🌐 Lazada Open\nPlatform API"]
        WH["📨 Lazada Push\nMechanism / Webhook"]
        SC["🏪 Lazada Seller\nCenter / Account"]
    end

    NOSHARE["🚫 No Third-Party\nData Sharing"]

    USER -- "① HTTPS/TLS\nLogin · View Orders\nManage Products" --> FE
    FE -- "② HTTPS/TLS + JWT\nAuthenticated API\nRequests" --> BE
    BE -- "③ HTTPS/TLS + OAuth\nGet Orders · Items\nSync Products · Inventory" --> API
    API -- "③ HTTPS/TLS\nOrder & Product\nData Responses" --> BE
    WH -- "④ Webhook\nOrder Notifications\nSignature Verified" --> BE
    BE -- "⑤ Backend-only Access\nStore Sensitive Data\n& Audit Logs" --> DB
    SC -. "⑥ Seller Account\nOAuth Authorization" .-> API

